<?xml version="1.0"?>
<sdf version="1.6">
  <model name="trackA_cone_red">
    <!-- 动态体:低速碰撞须能撞倒/撞动(撞桶表现验收前提) -->
    <static>false</static>
    <link name="cone">
      <inertial>
        <!-- 质量 1.0 kg asmp;惯量按等参圆柱 m(3r^2+h^2)/12, mr^2/2 实算 -->
        <mass>1.0</mass>
        <inertia><ixx>0.037975</ixx><iyy>0.037975</iyy><izz>0.009800000000000001</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <!-- visual: 底座 box + 16棱锥 mesh(高/底径=官方 630/280mm) -->
      <visual name="base">
        <pose>0 0 0.015 0 0 0</pose>
        <geometry><box><size>0.28 0.28 0.03</size></box></geometry>
        <material>
          <ambient>0.9 0.15 0.15 1.0</ambient>
          <diffuse>0.9 0.15 0.15 1.0</diffuse>
        </material>
      </visual>
      <visual name="cone">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>model://trackA_cone_red/meshes/traffic_cone.dae</uri></mesh></geometry>
        <material>
          <ambient>0.9 0.15 0.15 1.0</ambient>
          <diffuse>0.9 0.15 0.15 1.0</diffuse>
        </material>
      </visual>
      <!-- collision: 单圆柱 r=底径/2 h=锥高(官方 280/630mm;方座四角在柱外,保守) -->
      <collision name="body">
        <pose>0 0 0.315 0 0 0</pose>
        <geometry><cylinder><radius>0.14</radius><length>0.63</length></cylinder></geometry>
      </collision>
    </link>
  </model>
</sdf>
