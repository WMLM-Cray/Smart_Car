<?xml version="1.0" ?>
<!-- Red competition cone. Geometry shared with cone_blue (identical STL), colour only.
     Origin: centre of the base bottom face; pose z=0 -> model stands on the ground.
     Envelope (rule): total height 0.63 m, base 0.28 x 0.28 m.
     Base thickness / frustum diameters are assumptions (docs/assumptions.md).
     static=true: for scene/laser/camera testing only - NOT for push or
     displacement-penalty validation. -->
<sdf version="1.6">
  <model name="cone_red">
    <static>true</static>
    <link name="base_link">
      <!-- square base: 0.28 x 0.28 x 0.05, visual == collision -->
      <collision name="base_collision">
        <pose>0 0 0.025 0 0 0</pose>
        <geometry>
          <box>
            <size>0.28 0.28 0.05</size>
          </box>
        </geometry>
      </collision>
      <visual name="base_visual">
        <pose>0 0 0.025 0 0 0</pose>
        <geometry>
          <box>
            <size>0.28 0.28 0.05</size>
          </box>
        </geometry>
        <material>
          <ambient>0.60 0.05 0.05 1</ambient>
          <diffuse>0.85 0.10 0.10 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
        </material>
      </visual>
      <!-- frustum body: shared STL, mesh origin at frustum bottom centre,
           mounted at z = base thickness; visual == collision (same mesh) -->
      <collision name="frustum_collision">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://cone_red/meshes/cone_frustum.stl</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="frustum_visual">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://cone_red/meshes/cone_frustum.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.60 0.05 0.05 1</ambient>
          <diffuse>0.85 0.10 0.10 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
