[Unit]
# USB 相机。厂家的 racecar/launch/camer.launch.py 不能用,两处都和硬件对不上:
#   * 它要 pixel_format='yuyv',但这个 icspring 摄像头**只出 MJPG**
#   * 它要 320x240,硬件支持的是 1920x1080 / 1280x720 / 800x600 / 640x480 /
#     640x1024 / 608x1024,没有 320x240
#   而且 package='usb_cam' 在车上本来就没装(2026-09-22 才补上)。
#
# 选 640x480 的理由:车上现成的标定文件就是这个分辨率(camera_info.yaml,
# fx=438.78 cx=305.59 + plumb_bob 五个畸变系数),而且和 Gazebo 那边同分辨率
# 同内参、话题名也一样(/image_raw + /camera_info),认胶带的代码两边通用。
# 换 720p 要重新标定 —— 16:9 和 4:3 的视场角不同,不是缩放能换算的。
#
# mjpeg2rgb 是让 usb_cam 把 MJPG 解成 rgb8。实测 640x480 跑满 29.8Hz,
# OrangePi 解码没压力;1080p 没测过。
Description=HW-Autocar USB camera (usb_cam -> /image_raw + /camera_info)
After=network-online.target

[Service]
Type=simple
User=orange-pi
Environment=ROS_DOMAIN_ID=42
ExecStart=/bin/bash -c "source /opt/ros/humble/setup.bash && exec ros2 run usb_cam usb_cam_node_exe --ros-args \
  -p video_device:=/dev/video0 -p image_width:=640 -p image_height:=480 \
  -p pixel_format:=mjpeg2rgb -p framerate:=30.0 -p frame_id:=camera \
  -p camera_info_url:=file:///home/orange-pi/racecar/src/racecar/config/camera/camera_info.yaml"
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
