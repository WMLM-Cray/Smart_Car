Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ''
  Displays:
    - Alpha: 0.5
      Cell Size: 0.5
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Normal Cell Count: 0
      Offset: {X: 0, Y: 0, Z: 0}
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Map
      Topic: {Value: /map, Depth: 5, Durability Policy: Transient Local, Reliability Policy: Reliable}
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Description Topic: {Value: /robot_description}
      Enabled: true
      Name: RobotModel
      TF Prefix: ''
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Alpha: 1
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Color Transformer: FlatColor
      Color: 255; 0; 0
      Enabled: true
      Name: LaserScan
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (m): 0.03
      Style: Flat Squares
      Topic: {Value: /scan}
      Value: true
    - Angle Tolerance: 0.1
      Class: rviz_default_plugins/Odometry
      Enabled: true
      Keep: 100
      Name: Odometry
      Position Tolerance: 0.05
      Shape:
        Alpha: 1
        Axes Length: 0.3
        Axes Radius: 0.05
        Color: 255; 25; 0
        Head Length: 0.1
        Head Radius: 0.05
        Shaft Length: 0.15
        Shaft Radius: 0.03
        Value: Arrow
      Topic: {Value: /ackermann_steering_controller/odometry, Depth: 10, Durability Policy: Volatile, Reliability Policy: Reliable}
      Value: true
    - Alpha: 1
      Axes Length: 0.5
      Axes Radius: 0.05
      Class: rviz_default_plugins/PoseWithCovariance
      Color: 25; 255; 0
      Covariance:
        Orientation:
          Alpha: 0.5
          Color: 255; 255; 127
          Color Style: Unique
          Frame: Local
          Offset: 1
          Scale: 1
          Value: true
        Position:
          Alpha: 0.3
          Color: 204; 51; 204
          Scale: 5
          Value: true
        Value: true
      Enabled: true
      Head Length: 0.14
      Head Radius: 0.07
      Name: AMCL Pose
      Shaft Length: 0.25
      Shaft Radius: 0.04
      Topic: {Value: /amcl_pose, Depth: 5, Durability Policy: Volatile, Reliability Policy: Reliable}
      Value: true
    - Class: nav2_rviz_plugins/ParticleCloud
      Color: 0; 255; 255
      Enabled: true
      Name: Particle Cloud
      Topic: {Value: /particle_cloud, Depth: 5, Durability Policy: Volatile, Reliability Policy: Best Effort}
      Value: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: map
    Frame Rate: 15
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.28
      Topic: {Value: /initialpose}
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 14
      Enable Stereo Rendering: false
      Focal Point: {X: -3, Y: 2.0, Z: 0}
      Focal Shape Fixed Size: true
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.85
      Target Frame: <Fixed Frame>
      Yaw: 0
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1400
