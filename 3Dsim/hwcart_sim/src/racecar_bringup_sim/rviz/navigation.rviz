Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Color: 110; 110; 115
      Line Style:
        Line Width: 0.008
        Value: Lines
      Normal Cell Count: 0
      Plane Cell Count: 60
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Map
      Alpha: 0.35
      Color Scheme: map
      Draw Behind: true
      Topic: {Value: /map, Depth: 1, Durability Policy: Transient Local, Reliability Policy: Reliable}
      Value: true
    - Class: rviz_default_plugins/Map
      Name: GlobalCostmap
      Alpha: 0.45
      Color Scheme: costmap
      Draw Behind: false
      Topic: {Value: /global_costmap/costmap, Depth: 1, Durability Policy: Volatile, Reliability Policy: Reliable}
      Value: true
    - Class: rviz_default_plugins/Map
      Name: LocalCostmap
      Alpha: 0.35
      Color Scheme: costmap
      Draw Behind: false
      Topic: {Value: /local_costmap/costmap, Depth: 1, Durability Policy: Volatile, Reliability Policy: Reliable}
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Description Source: Topic
      Description Topic: {Value: /robot_description, Depth: 5, Durability Policy: Transient Local, Reliability Policy: Reliable}
      TF Prefix: ""
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Frame Timeout: 15
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Color: 255; 0; 0
      Color Transformer: FlatColor
      Size (m): 0.02
      Style: Points
      Topic: {Value: /scan, Depth: 5, Durability Policy: Volatile, Reliability Policy: Best Effort}
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Keep: 4000
      Position Tolerance: 0.02
      Angle Tolerance: 0.05
      Shape: Points
      Axes Radius: 0.03
      Topic: {Value: /ackermann_steering_controller/odometry, Depth: 10, Durability Policy: Volatile, Reliability Policy: Reliable}
      Value: true
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: AMCL Pose
      Covariance:
        Orientation:
          Alpha: 0.5
          Color: 0; 255; 0
        Position:
          Alpha: 0.3
          Color: 0; 255; 0
          Scale: 1
      Pose:
        Alpha: 1
        Color: 0; 255; 0
        Shaft Length: 0.2
        Shaft Radius: 0.02
        Head Length: 0.08
        Head Radius: 0.04
      Shape: Arrow
      Topic: {Value: /amcl_pose, Depth: 5, Durability Policy: Transient Local, Reliability Policy: Reliable}
      Value: true
    - Class: nav2_rviz_plugins/ParticleCloud
      Color: 0; 255; 255
      Enabled: true
      Name: Particle Cloud
      Topic: {Value: /particle_cloud, Depth: 5, Durability Policy: Volatile, Reliability Policy: Best Effort}
      Value: true
    - Class: rviz_default_plugins/Path
      Name: GlobalPath
      Alpha: 1
      Buffer Length: 20
      Color: 25; 255; 0
      Line Style: Billboards
      Line Width: 0.03
      Topic: {Value: /plan, Depth: 20, Durability Policy: Volatile, Reliability Policy: Reliable}
      Value: true
    - Class: rviz_default_plugins/Path
      Name: LocalPath
      Alpha: 1
      Buffer Length: 5
      Color: 255; 255; 0
      Line Style: Billboards
      Line Width: 0.02
      Topic: {Value: /local_plan, Depth: 5, Durability Policy: Volatile, Reliability Policy: Reliable}
      Value: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: map
    Frame Rate: 15
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.28
      Topic: {Value: /initialpose}
    - Class: rviz_default_plugins/SetGoal
      Topic: {Value: /goal_pose}
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 16
      Enable Stereo Rendering: false
      Focal Point: {X: -3, Y: 2.0, Z: 0}
      Focal Shape Fixed Size: true
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.85
      Target Frame: <Fixed Frame>
      Yaw: 0
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1400
