<?xml version="1.0" ?>
<!-- Static traffic light (test fixture). All dimensions are ASSUMPTIONS
     (docs/assumptions.md): pole r=0.05/h=1.80 m, housing 0.30 x 0.16 x 0.66 m,
     three always-on spherical lenses r=0.07 m (red/yellow/green top-to-bottom).
     Origin: centre of the pole bottom face (pose z=0 -> stands on the ground).
     Local axes: housing front faces +Y (yaw rotates it in the ground plane).
     STATIC MODEL: there is NO runtime switch interface - the lenses are
     always-on coloured geometry, not switchable. static=true: test-only,
     not for signal-control validation. -->
<sdf version="1.6">
  <model name="traffic_light">
    <static>true</static>
    <link name="base_link">
      <!-- pole: cylinder r=0.05, h=1.80, centre z=0.90 -->
      <collision name="pole_collision">
        <pose>0 0 0.90 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>1.80</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="pole_visual">
        <pose>0 0 0.90 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>1.80</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.20 0.20 0.20 1</ambient>
          <diffuse>0.35 0.35 0.35 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
        </material>
      </visual>

      <!-- housing: box 0.30 x 0.16 x 0.66, bottom z=1.80, centre z=2.13 -->
      <collision name="housing_collision">
        <pose>0 0 2.13 0 0 0</pose>
        <geometry>
          <box>
            <size>0.30 0.16 0.66</size>
          </box>
        </geometry>
      </collision>
      <visual name="housing_visual">
        <pose>0 0 2.13 0 0 0</pose>
        <geometry>
          <box>
            <size>0.30 0.16 0.66</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.25 0.25 0.25 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
        </material>
      </visual>

      <!-- red lens (top), centre z=2.33, on the housing front (+Y) -->
      <collision name="red_lens_collision">
        <pose>0 0.095 2.33 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.07</radius>
          </sphere>
        </geometry>
      </collision>
      <visual name="red_lens_visual">
        <pose>0 0.095 2.33 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.07</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.60 0.05 0.05 1</ambient>
          <diffuse>0.85 0.10 0.10 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
        </material>
      </visual>

      <!-- yellow lens (middle), centre z=2.13 -->
      <collision name="yellow_lens_collision">
        <pose>0 0.095 2.13 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.07</radius>
          </sphere>
        </geometry>
      </collision>
      <visual name="yellow_lens_visual">
        <pose>0 0.095 2.13 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.07</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.60 0.55 0.05 1</ambient>
          <diffuse>0.85 0.80 0.10 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
        </material>
      </visual>

      <!-- green lens (bottom), centre z=1.93 -->
      <collision name="green_lens_collision">
        <pose>0 0.095 1.93 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.07</radius>
          </sphere>
        </geometry>
      </collision>
      <visual name="green_lens_visual">
        <pose>0 0.095 1.93 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.07</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.05 0.50 0.05 1</ambient>
          <diffuse>0.10 0.75 0.15 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
