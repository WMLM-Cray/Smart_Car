<?xml version="1.0" ?>
<!-- Blue boundary board. Rule dimensions: length 0.80 m, height 0.50 m.
     Thickness 0.02 m is an ASSUMPTION (docs/assumptions.md).
     Origin: centre of the bottom edge (pose z=0 -> bottom edge on the ground).
     Local axes: X = length, Y = thickness, Z = height.
     Box geometry is a valid proxy for a flat board (unlike cones, which must
     not use box proxies). No unconfirmed supports, text or markings added.
     static=true: test-only. -->
<sdf version="1.6">
  <model name="blue_board">
    <static>true</static>
    <link name="base_link">
      <collision name="collision">
        <pose>0 0 0.25 0 0 0</pose>
        <geometry>
          <box>
            <size>0.80 0.02 0.50</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 0.25 0 0 0</pose>
        <geometry>
          <box>
            <size>0.80 0.02 0.50</size>
          </box>
        </geometry>
        <material>
          <ambient>0.03 0.10 0.60 1</ambient>
          <diffuse>0.05 0.15 0.85 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
