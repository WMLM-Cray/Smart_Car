<?xml version="1.0" ?>
<!-- Grey distance-reference box. Test fixture, NOT a race prop.
     Size: 0.5 (X) x 1.0 (Y) x 1.0 (Z) m.
     Origin: centre of the bottom face (pose z=0 -> bottom on the ground).
     At world pose x=8.0, y=0 the front (+X-facing) surface sits at x=7.75 m.
     static=true: test-only. -->
<sdf version="1.6">
  <model name="reference_box">
    <static>true</static>
    <link name="base_link">
      <collision name="collision">
        <pose>0 0 0.5 0 0 0</pose>
        <geometry>
          <box>
            <size>0.5 1.0 1.0</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 0.5 0 0 0</pose>
        <geometry>
          <box>
            <size>0.5 1.0 1.0</size>
          </box>
        </geometry>
        <material>
          <ambient>0.40 0.40 0.40 1</ambient>
          <diffuse>0.60 0.60 0.60 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
