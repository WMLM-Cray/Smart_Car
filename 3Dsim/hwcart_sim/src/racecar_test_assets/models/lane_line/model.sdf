<?xml version="1.0" ?>
<!-- White lane line (test fixture). All dimensions are ASSUMPTIONS
     (docs/assumptions.md): 3.00 m long (X), 0.15 m wide (Y), 0.01 m thick (Z).
     Origin: centre of the bottom face (pose z=0 -> bottom face on the ground).
     Local axes: X = length, Y = width, Z = thickness.
     Box geometry (visual == collision); no texture. static=true: test-only. -->
<sdf version="1.6">
  <model name="lane_line">
    <static>true</static>
    <link name="base_link">
      <collision name="collision">
        <pose>0 0 0.005 0 0 0</pose>
        <geometry>
          <box>
            <size>3.00 0.15 0.01</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 0.005 0 0 0</pose>
        <geometry>
          <box>
            <size>3.00 0.15 0.01</size>
          </box>
        </geometry>
        <material>
          <ambient>0.60 0.60 0.60 1</ambient>
          <diffuse>0.90 0.90 0.90 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
