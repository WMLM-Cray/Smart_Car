# --- ROS2 / colcon 构建产物 ---
build/
install/
log/
*.pyc
__pycache__/

# --- Gazebo / RViz 运行时 ---
*.log
*.sqlite
.gazebo/

# --- 生成产物(track_generator 输出) ---
work/

# --- 数据大文件(地图/包录制的bag不入库,放 release 或网盘) ---
*.bag
*.db3
*.pgm.bak

# --- 编辑器/系统 ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
.baiduyun.uploading.cfg

# --- 证据归档例外:验证完整日志必须入库(外部AI审查建议:日志归档规则) ---
!evidence/*.log

# --- 内部工作文件(不入远程) ---
CLAUDE.md
docs/IMPLEMENTATION_STATUS.md

# --- Python 测试缓存 ---
.pytest_cache/

# --- 训练产物(模型/曲线/日志,不入库) ---
runs/
*.log
