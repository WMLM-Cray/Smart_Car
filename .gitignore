# --- ROS2 / colcon 构建产物 ---
build/
install/
log/
*.pyc
__pycache__/

# --- Gazebo / RViz 运行时 ---
*.log
*.sqlite
.gazebo/

# --- 生成产物(track_generator 输出) ---
work/

# --- 数据大文件(地图/包录制的bag不入库,放 release 或网盘) ---
*.bag
*.db3
*.pgm.bak

# --- 编辑器/系统 ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
.baiduyun.uploading.cfg

# --- 证据归档例外:验证完整日志必须入库(外部AI审查建议:日志归档规则) ---
!evidence/*.log

# --- 内部工作文件(不入远程) ---
CLAUDE.md
docs/IMPLEMENTATION_STATUS.md

# --- Python 测试缓存 ---
.pytest_cache/

# --- 训练产物(模型/曲线/日志,不入库) ---
runs/*
*.log

# 例外:上过车的策略权重要入库。这是全项目最难复现的东西,只存在本机和车上,
# 丢了要重训。单份 ~0.5MB,.npz 是二进制存不了增量,所以只提交真正跑过的版本,
# 中间试验产物照旧留在 runs/ 里不管。
!runs/policy_*.npz
