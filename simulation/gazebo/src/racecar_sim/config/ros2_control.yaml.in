# =============================================================================
# controller_manager + ackermann_steering_controller 参数【模板】
# __*__ 占位符由 launch 从 config/params.yaml 注入生成运行时配置
# (改几何只动 params.yaml 一处,全局生效;勿手改本文件再另存副本)
#
# 轮序约定(2026-09-14 返工,读 ros2_controllers 2.53.3 源码确认):
#   ackermann_steering_controller.hpp 静态索引
#   STATE_TRACTION_RIGHT_WHEEL=0 / LEFT=1 / STEER_RIGHT=2 / LEFT=3,
#   接口按 wheels_names 列表顺序编号 →
#   ** front/rear_wheels_names 必须写 [右, 左] 顺序 **
#   (此前写成 [左, 右] 导致正向转弯世界航向反向、里程计虚高)
#
# 接口参数名从 libackermann_steering_controller.so strings 核对
# =============================================================================

controller_manager:
  ros__parameters:
    update_rate: 100          # Hz
    use_sim_time: true

    joint_state_broadcaster:
      type: joint_state_broadcaster/JointStateBroadcaster

    ackermann_steering_controller:
      type: ackermann_steering_controller/AckermannSteeringController

ackermann_steering_controller:
  ros__parameters:
    # 关节名 = racecar.xacro 中 ros2_control 块的 joint name
    # 顺序 [右, 左]!
    front_wheels_names:
      - right_steering_joint
      - left_steering_joint
    rear_wheels_names:
      - right_rear_wheel_joint
      - left_rear_wheel_joint
    # 几何(= params.yaml: wheel_base / wheel_track / wheel_radius 注入)
    wheelbase: __WHEELBASE__
    front_wheel_track: __WHEEL_TRACK__
    rear_wheel_track: __WHEEL_TRACK__
    front_wheels_radius: __WHEEL_RADIUS__
    rear_wheels_radius: __WHEEL_RADIUS__
    # sim_wiring forwards geometry_msgs/Twist to reference_unstamped; keep this
    # explicit because controller releases may default to TwistStamped.
    use_stamped_vel: false
    open_loop: false           # 闭环:轮速反馈参与运动学
    use_sim_time: true
    # 里程计 TF:steering_controllers_library 默认 enable_odom_tf=false
    # (与 diff_drive 默认 true 不同,不开就没有 odom frame)
    enable_odom_tf: true
    odom_frame_id: odom
    base_frame_id: base_footprint
    # /cmd_vel 接线:gzserver 不解析 --ros-args,无法 remap;由 racecar_sim
    # 的 sim_wiring 节点转发到 ~/reference_unstamped(见 launch 第 5 步)
